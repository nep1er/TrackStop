<Window x:Class="TrackStop.ViewModels.AdminControlPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="🎛️ Админ-панель" Height="700" Width="900"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и навигация -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🎛️ Админ-панель" 
                       FontSize="28" FontWeight="Bold" 
                       Foreground="#FFDA0000"/>
            <TextBlock Text="Полный контроль над системой" 
                       FontSize="14" 
                       Foreground="#AAAAAA"
                       Margin="0,5,0,20"/>

            <TabControl x:Name="AdminTabs" Height="500">
                <TabItem Header="👥 Пользователи">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Поиск пользователей -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBox x:Name="UserSearchBox" 
                                     Width="300"
                                     materialDesign:HintAssist.Hint="Поиск пользователей..."
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Margin="0,0,10,0"/>
                            <Button Content="🔍 Поиск" 
                                    Click="SearchUsersButton_Click"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
                        </StackPanel>

                        <!-- Список пользователей -->
                        <ListView Grid.Row="1" 
                                  x:Name="UsersListView" 
                                  ScrollViewer.VerticalScrollBarVisibility="Visible"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.CanContentScroll="True"
                                  Height="400">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ID" Width="50" DisplayMemberBinding="{Binding UserId}"/>
                                    <GridViewColumn Header="Логин" Width="150" DisplayMemberBinding="{Binding Login}"/>
                                    <GridViewColumn Header="Роль" Width="100" DisplayMemberBinding="{Binding Role}"/>
                                    <GridViewColumn Header="Действия" Width="200">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="🗑️ Удалить" 
                                                            Tag="{Binding UserId}"
                                                            Click="DeleteUserButton_Click"
                                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                                            Foreground="Red"
                                                            Margin="0,0,5,0"
                                                            Width="80"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </TabItem>

                <TabItem Header="🎵 Альбомы">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Поиск альбомов -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBox x:Name="AlbumSearchBox" 
                                     Width="300"
                                     materialDesign:HintAssist.Hint="Поиск альбомов..."
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Margin="0,0,10,0"/>
                            <Button Content="🔍 Поиск" 
                                    Click="SearchAlbumsButton_Click"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
                        </StackPanel>

                        <!-- Список альбомов -->
                        <ListView Grid.Row="1" 
                                  x:Name="AlbumsListView" 
                                  ScrollViewer.VerticalScrollBarVisibility="Visible"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.CanContentScroll="True"
                                  Height="400">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ID" Width="50" DisplayMemberBinding="{Binding Id}"/>
                                    <GridViewColumn Header="Название" Width="200" DisplayMemberBinding="{Binding Title}"/>
                                    <GridViewColumn Header="Исполнитель" Width="150" DisplayMemberBinding="{Binding Artist}"/>
                                    <GridViewColumn Header="Действия" Width="200">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="🗑️ Удалить" 
                                                            Tag="{Binding Id}"
                                                            Click="DeleteAlbumButton_Click"
                                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                                            Margin="0,0,5,0"
                                                            Foreground="Red"
                                                            Width="80"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </TabItem>

                <TabItem Header="🎶 Песни">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Поиск песен -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBox x:Name="SongSearchBox" 
                                     Width="300"
                                     materialDesign:HintAssist.Hint="Поиск песен..."
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Margin="0,0,10,0"/>
                            <Button Content="🔍 Поиск" 
                                    Click="SearchSongsButton_Click"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
                        </StackPanel>

                        <!-- Список песен -->
                        <ListView Grid.Row="1" 
                                  x:Name="SongsListView" 
                                  ScrollViewer.VerticalScrollBarVisibility="Visible"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.CanContentScroll="True"
                                  Height="400">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ID" Width="50" DisplayMemberBinding="{Binding Id}"/>
                                    <GridViewColumn Header="Название" Width="200" DisplayMemberBinding="{Binding Title}"/>
                                    <GridViewColumn Header="Исполнитель" Width="150" DisplayMemberBinding="{Binding Artist}"/>
                                    <GridViewColumn Header="Альбом" Width="150" DisplayMemberBinding="{Binding Album}"/>
                                    <GridViewColumn Header="Действия" Width="150">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="🗑️ Удалить" 
                                                        Tag="{Binding Id}"
                                                        Click="DeleteSongButton_Click"
                                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                                        Foreground="Red"
                                                        Width="80"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </TabItem>

                <TabItem Header="📊 Статистика">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="10">
                            <TextBlock Text="📈 Статистика системы" 
                                       FontSize="18" FontWeight="Bold"
                                       Margin="0,0,0,15"/>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="👥 Пользователей: " 
                                               FontSize="14" FontWeight="Bold"/>
                                    <TextBlock x:Name="UsersCountText" 
                                               Text="0" 
                                               FontSize="14"
                                               Foreground="#FFDA0000"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="🎤 Исполнителей: " 
                                               FontSize="14" FontWeight="Bold"/>
                                    <TextBlock x:Name="ArtistsCountText" 
                                               Text="0" 
                                               FontSize="14"
                                               Foreground="#FFDA0000"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="🎵 Альбомов: " 
                                               FontSize="14" FontWeight="Bold"/>
                                    <TextBlock x:Name="AlbumsCountText" 
                                               Text="0" 
                                               FontSize="14"
                                               Foreground="#FFDA0000"/>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Orientation="Horizontal">
                                    <TextBlock Text="🎶 Песен: " 
                                               FontSize="14" FontWeight="Bold"/>
                                    <TextBlock x:Name="SongsCountText" 
                                               Text="0" 
                                               FontSize="14"
                                               Foreground="#FFDA0000"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </StackPanel>

        <!-- Кнопки управления -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="🔄 Обновить" 
                    Click="RefreshButton_Click"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Margin="0,0,10,0"/>
            <Button Content="❌ Закрыть" 
                    Click="CloseButton_Click"
                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
        </StackPanel>
    </Grid>
</Window>
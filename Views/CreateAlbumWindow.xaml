<Window x:Class="TrackStop.ViewModels.CreateAlbumWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Создание альбома" Height="500" Width="500"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="➕ Создание альбома" 
                   FontSize="24" FontWeight="Bold" 
                   Foreground="#FFDA0000" 
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <TextBox x:Name="AlbumTitleTextBox" 
                     materialDesign:HintAssist.Hint="Название альбома" 
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     FontSize="16"
                     Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Button Content="🖼️ Выбрать обложку" 
                        Click="SelectCoverButton_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Margin="0,0,15,0"/>
                <TextBlock x:Name="CoverPathText" 
                           Text="Обложка не выбрана" 
                           Foreground="Gray"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <Border BorderBrush="#CCCCCC" BorderThickness="1" 
                    Background="#F5F5F5" 
                    Width="200" Height="200"
                    Margin="0,0,0,20">
                <Image x:Name="CoverPreview" 
                       Stretch="Uniform"/>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="💾 Создать" 
                    Click="CreateButton_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#FFDA0000" Foreground="White"
                    Margin="0,0,10,0"
                    Width="100"/>
            <Button Content="❌ Отмена" 
                    Click="CancelButton_Click"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Width="100"/>
        </StackPanel>
    </Grid>
</Window>
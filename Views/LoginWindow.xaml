<Window x:Class="TrackStop.ViewModels.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="TrackStop - Вход" Height="517" Width="402"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Background="{DynamicResource MaterialDesignPaper}" Margin="0,0,0,-16">
        <materialDesign:Card Margin="30,30,30,10" Padding="30">
            <StackPanel Margin="0,0,0,-29">
                <TextBlock Text="📼 TrackStop" 
                           FontSize="28" FontWeight="Bold" 
                           Foreground="#FFAB0000" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,30"/>

                <TextBox x:Name="LoginTextBox" 
                         materialDesign:HintAssist.Hint="Логин" 
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         FontSize="16" Margin="0,0,0,20"/>

                <PasswordBox x:Name="PasswordBox" 
                             materialDesign:HintAssist.Hint="Пароль" 
                             Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                             FontSize="16" Margin="0,0,0,30"/>

                <Button x:Name="LoginButton" 
                        Content="Войти" 
                        Click="LoginButton_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#FFAB0000" Foreground="White"
                        FontSize="16" Height="40" Margin="0,0,0,15"/>

                <Button x:Name="RegisterButton" 
                        Content="Создать аккаунт" 
                        Click="RegisterButton_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Foreground="#FFAB0000" BorderBrush="#FFAB0000"
                        FontSize="14" Height="35"/>

                <TextBlock x:Name="MessageText" 
                           Text="" 
                           Foreground="Red" 
                           HorizontalAlignment="Center" 
                           Margin="0,15,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</Window>
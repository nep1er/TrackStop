<Window x:Class="TrackStop.ViewModels.ArtistSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Настройки исполнителя" Height="500" Width="600"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="🎤 Настройки исполнителя" 
                   FontSize="24" FontWeight="Bold" 
                   Foreground="#FFDA0000" 
                   Margin="0,0,0,20"/>

        <TabControl Grid.Row="1">
            <TabItem Header="Профиль">
                <StackPanel Margin="10">
                    <TextBox x:Name="ArtistNameTextBox" 
                             materialDesign:HintAssist.Hint="Имя исполнителя" 
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,0,15"/>

                    <TextBox x:Name="ArtistBioTextBox" 
                             materialDesign:HintAssist.Hint="Биография" 
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Height="80" TextWrapping="Wrap"
                             Margin="0,0,0,15"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Button Content="📷 Сменить аватар" 
                                Click="ChangeAvatarButton_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,10,0"/>
                        <TextBlock x:Name="AvatarPathText" Text="Аватар не выбран" Foreground="Gray"/>
                    </StackPanel>

                    <Image x:Name="AvatarPreview" Width="100" Height="100" 
                           Stretch="UniformToFill" Margin="0,0,0,15"/>

                    <Button Content="💾 Сохранить изменения" 
                            Click="SaveProfileButton_Click"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#FFDA0000" Foreground="White"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Creative Studio">
                <StackPanel Margin="10">
                    <TextBlock Text="Ваши альбомы" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                    <Button Content="➕ Создать альбом" 
                            Click="CreateAlbumButton_Click"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,0,15"/>

                    <ListView x:Name="ArtistAlbumsListView" Height="200">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Название" Width="200" DisplayMemberBinding="{Binding Title}"/>
                                <GridViewColumn Header="Песен" Width="80" DisplayMemberBinding="{Binding SongCount}"/>
                                <GridViewColumn Header="Действия" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="✏️" 
                                                        Tag="{Binding Id}"
                                                        Click="EditAlbumButton_Click"
                                                        Style="{StaticResource MaterialDesignIconButton}"
                                                        Margin="0,0,5,0"/>
                                                <Button Content="🗑️" 
                                                        Tag="{Binding Id}"
                                                        Click="DeleteAlbumButton_Click"
                                                        Style="{StaticResource MaterialDesignIconButton}"
                                                        Foreground="Red"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </TabItem>

            <TabItem Header="Учетная запись">
                <StackPanel Margin="10">
                    <TextBlock Text="Управление аккаунтом" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                    <Button Content="🚪 Выйти из аккаунта" 
                            Click="LogoutButton_Click"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="Red" BorderBrush="Red"
                            Margin="0,0,0,15"/>

                    <TextBlock Text="⚠️ Внимание: вы не сможете войти снова как исполнитель, если выйдете из аккаунта. Только как обычный пользователь."
                               FontSize="12" Foreground="#FFDA0000"
                               TextWrapping="Wrap" MaxWidth="400"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="❌ Закрыть" 
                    Click="CloseButton_Click"
                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
        </StackPanel>
    </Grid>
</Window>
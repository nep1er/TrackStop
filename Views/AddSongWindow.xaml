<Window x:Class="TrackStop.ViewModels.AddSongWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Добавление песни" Height="400" Width="500"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="➕ Добавление песни" 
                   FontSize="24" FontWeight="Bold" 
                   Foreground="#FFDA0000" 
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <TextBox x:Name="SongTitleTextBox" 
                     materialDesign:HintAssist.Hint="Название песни" 
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     FontSize="16"
                     Margin="0,0,0,20"/>

            <TextBlock Text="🎵 Выберите аудиофайл"
                       FontSize="14" FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Button Content="📁 Выбрать файл" 
                        Click="SelectAudioFileButton_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Margin="0,0,15,0"/>
                <TextBlock x:Name="AudioFilePathText" 
                           Text="Файл не выбран" 
                           Foreground="Gray"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="Поддерживаемые форматы: MP3, WAV, FLAC"
                       FontSize="12" Foreground="#666666"
                       Margin="0,0,0,20"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="💾 Добавить" 
                    Click="AddButton_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#FFDA0000" Foreground="White"
                    Margin="0,0,10,0"
                    Width="100"/>
            <Button Content="❌ Отмена" 
                    Click="CancelButton_Click"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Width="100"/>
        </StackPanel>
    </Grid>
</Window>
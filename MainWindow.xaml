<Window x:Class="TrackStop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:TrackStop"
        xmlns:selector="clr-namespace:TrackStop.Models.Search"
        mc:Ignorable="d"
        Title="TrackStop" Height="900" Width="1600"
        WindowStartupLocation="CenterScreen"
        Background="#0F0F0F"
        Foreground="White"
        FontFamily="Segoe UI">

    <Grid>
        <!-- Градиентный фон -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0F0F0F" Offset="0"/>
                <GradientStop Color="#1A1A1A" Offset="0.5"/>
                <GradientStop Color="#0F0F0F" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="500"/>
        </Grid.ColumnDefinitions>

        
        
        
        <!-- Боковая панель (слева) -->
        <Border Grid.Column="0" 
                Background="#121212" 
                BorderBrush="#FF1A1A1A" 
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Логотип -->
                <StackPanel Grid.Row="0" Margin="25,30,25,40">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <materialDesign:PackIcon Kind="Music" 
                                                  Foreground="#FFDA0000" 
                                                  Width="32" Height="32"
                                                  Margin="0,0,12,0"/>
                        <TextBlock Text="TRACKSTOP" 
                                   FontSize="28" 
                                   FontWeight="Bold"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Your music universe"
                               FontSize="14"
                               Foreground="#AAAAAA"
                               Margin="0,0,0,25"/>
                </StackPanel>

                <!-- Навигация -->
                <StackPanel Grid.Row="1" Margin="0,0,0,30">
                    <Button x:Name="HomeButton" 
                            Click="HomeButton_Click"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Margin="20,8"
                            Height="48">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Home" 
                                                      Foreground="#FFDA0000"
                                                      Width="22" Height="22"
                                                      Margin="0,0,15,0"/>
                            <TextBlock Text="Home" 
                                       FontSize="16" 
                                       Foreground="White"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="PlaylistsButton" 
                            Click="PlaylistsButton_Click"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Margin="20,8"
                            Height="48">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PlaylistMusic" 
                                                      Foreground="#FFDA0000"
                                                      Width="22" Height="22"
                                                      Margin="0,0,15,0"/>
                            <TextBlock Text="Playlists" 
                                       FontSize="16" 
                                       Foreground="White"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="FavoriteArtistsButton" 
                            Click="FavoriteArtistsButton_Click"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Margin="20,8"
                            Height="48">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Heart" 
                                                      Foreground="#FFDA0000"
                                                      Width="22" Height="22"
                                                      Margin="0,0,15,0"/>
                            <TextBlock Text="Favourite Artists" 
                                       FontSize="16" 
                                       Foreground="White"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="FavoriteSongsButton" 
                            Click="FavoriteSongsButton_Click"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Margin="20,8"
                            Height="48">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Star" 
                                                      Foreground="#FFDA0000"
                                                      Width="22" Height="22"
                                                      Margin="0,0,15,0"/>
                            <TextBlock Text="Liked Songs" 
                                       FontSize="16" 
                                       Foreground="White"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Текущий пользователь -->
                <Border Grid.Row="2" 
                        Background="#1A1A1A" 
                        CornerRadius="10"
                        Margin="20,0,20,25"
                        Padding="15"
                        Cursor="Hand"
                        MouseDown="UserProfile_MouseDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <materialDesign:PackIcon Kind="Account" 
                                  Foreground="#FFDA0000"
                                  Width="24" Height="24"
                                  Margin="0,0,12,0"/>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding CurrentUserName}" 
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>
                            <TextBlock x:Name="UserRoleText"
                                       Text="User"
                                       FontSize="12"
                                       Foreground="#AAAAAA"/>
                                        </StackPanel>

                        <!-- Кнопка для исполнителей (только для исполнителей) -->
                        <Button x:Name="ArtistProfileButton"
                                Grid.Column="2"
                                Content="🎤"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Foreground="#FFDA0000"
                                Width="30" Height="30"
                                Margin="5,0,0,0"
                                Click="ArtistProfileButton_Click"
                                Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Центральная область -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Панель поиска -->
            <Border Grid.Row="0" 
                    Background="#1A1A1A" 
                    Margin="30,30,30,20"
                    CornerRadius="15"
                    Padding="20">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Magnify" 
                                  Foreground="#FFDA0000"
                                  Width="28" Height="28"
                                  Margin="0,0,15,0"/>
                    <TextBox x:Name="SearchBox"
                             Width="500"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Search artists, albums, songs..."
                             materialDesign:HintAssist.Foreground="#AAAAAA"
                             Background="Transparent"
                             BorderBrush="#333333"
                             Foreground="White"
                             FontSize="16"
                             Padding="12"
                             VerticalContentAlignment="Center"/>

                    <!-- Кнопка фильтрации -->
                    <Button x:Name="FilterButton"
                            Content="🎚️"
                            Click="FilterButton_Click"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Foreground="#FFDA0000"
                            Margin="10,0,0,0"
                            Width="40" Height="40"
                            ToolTip="Filter by genre"/>

                    <Button x:Name="ExitBtn" 
                            Content="⚙"
                            Click="ExitBtn_Click"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Foreground="#FFDA0000"
                            Margin="10,0,0,0"
                            Width="40" Height="40"/>
                            </StackPanel>
            </Border>

            <!-- Popup для фильтрации -->
            <Popup x:Name="FilterPopup"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=FilterButton}"
                   StaysOpen="False"
                   PopupAnimation="Slide"
                   AllowsTransparency="True"
                   Width="300">
                <Border Background="#1A1A1A"
                        CornerRadius="10"
                        BorderBrush="#333333"
                        BorderThickness="1"
                        Margin="0,5,0,0">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="3" BlurRadius="10" Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel Margin="15">
                        <TextBlock Text="Filter by Genre" 
                       FontSize="16" 
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,10"/>

                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="GenreFilterList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Foreground="White"
                                      Margin="0,5"
                                      Checked="GenreCheckBox_Checked"
                                      Unchecked="GenreCheckBox_Unchecked"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Select All" 
                                    Click="SelectAllGenres_Click"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Foreground="#AAAAAA"
                                    Margin="0,0,5,0"/>
                            <Button Content="Clear All" 
                                    Click="ClearAllGenres_Click"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Foreground="#AAAAAA"/>
                            <Button Content="Apply" 
                                    Click="ApplyFilter_Click"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Foreground="#FFDA0000" BorderBrush="#FFDA0000"
                                    Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Основной контент -->
            <materialDesign:Card Grid.Row="1" 
                                 Margin="30,0,30,30"
                                 Background="#121212"
                                 UniformCornerRadius="15"
                                 Padding="25">
                <Grid>

                    <TextBlock x:Name="AlbumTitleHeader"
                                Text=""
                                FontSize="28" 
                                FontWeight="Bold"
                                Foreground="White"
                                Margin="0,0,0,20"
                                Visibility="Collapsed"
                                HorizontalAlignment="Left"/>

                    <!-- AlbumsGrid -->
                    <!-- AlbumsGrid для главной страницы и поиска -->
                    <ListView x:Name="AlbumsGrid" 
                                Visibility="Visible" 
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                Background="Transparent"
                                BorderThickness="0">


                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.Resources>


                            <!-- Шаблон для заголовка секции -->
                            <DataTemplate x:Key="SectionHeaderTemplate">
                                <Grid Margin="10,20,10,5" Width="1000">
                                    <Border Background="#FFAB0000" CornerRadius="4" Padding="10,5">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" FontSize="16" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16" Foreground="White"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>

                            <!-- Шаблон для разделителя -->
                            <DataTemplate x:Key="SeparatorTemplate">
                                <Border Height="1" Background="#FFCCCCCC" Margin="10,15" Width="1000"/>
                            </DataTemplate>

                            <!-- Шаблон для "Ничего не найдено" -->
                            <DataTemplate x:Key="NoResultsTemplate">
                                <Grid Margin="10" Height="100" Width="1000">
                                    <Border CornerRadius="8" Background="#FFF5F5F5" BorderBrush="#FFCCCCCC" BorderThickness="1">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Icon}" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                            <TextBlock Text="{Binding Message}" FontSize="14" Foreground="Gray" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>

                            <!-- Шаблон для жанра -->
                            <DataTemplate x:Key="GenreTemplate">
                                <Border CornerRadius="12" 
                                        Background="#1A1A1A" 
                                        BorderBrush="#FFDA0000" 
                                        BorderThickness="2"
                                        Margin="8"
                                        Width="280"
                                        Height="100"
                                        Cursor="Hand">
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="0" BlurRadius="20" Opacity="0.3"/>
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal" 
                                                VerticalAlignment="Center"
                                                MouseDown="GenreSearchItem_MouseDown">
                                        <TextBlock Text="🎵" 
                                                   FontSize="32" 
                                                   Margin="20,0,15,0"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" 
                                                       FontWeight="Bold" 
                                                       FontSize="18" 
                                                       Foreground="#FFDA0000"/>
                                            <TextBlock Text="Genre" 
                                                       FontSize="14" 
                                                       Foreground="#AAAAAA"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>

                            <!-- Шаблон для артиста -->
                            <DataTemplate x:Key="ArtistTemplate">
                                <Border CornerRadius="12" 
                                        Background="#1A1A1A" 
                                        Margin="12"
                                        Width="200"
                                        Height="260"
                                        Cursor="Hand">
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="0" BlurRadius="20" Opacity="0.3"/>
                                    </Border.Effect>
                                    <StackPanel MouseDown="ArtistSearchItem_MouseDown">
                                        <Border CornerRadius="12,12,0,0" 
                                                Height="160" 
                                                ClipToBounds="True">
                                            <Image Source="{Binding PhotoPath}" 
                                                    Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel Margin="15,15">
                                            <TextBlock Text="{Binding Name}" 
                                   FontWeight="Bold" 
                                   FontSize="16" 
                                   Foreground="White"
                                   TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="Artist" 
                                   FontSize="14" 
                                   Foreground="#AAAAAA"
                                   FontStyle="Italic"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>

                            <!-- Шаблон для альбома -->
                            <DataTemplate x:Key="AlbumTemplate">
                                <Border CornerRadius="12" 
                    Background="#1A1A1A" 
                    Margin="12"
                    Width="200"
                    Height="260"
                    Cursor="Hand">
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="0" BlurRadius="20" Opacity="0.3"/>
                                    </Border.Effect>
                                    <StackPanel MouseDown="Album_Click">
                                        <Border CornerRadius="12,12,0,0" 
                            Height="160" 
                            ClipToBounds="True">
                                            <Image Source="{Binding CoverPath}" 
                               Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel Margin="15,15">
                                            <TextBlock Text="{Binding Title}" 
                                   FontWeight="Bold" 
                                   FontSize="16" 
                                   Foreground="White"
                                   TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Artist}" 
                                   FontSize="14" 
                                   Foreground="#AAAAAA"/>
                                            <!-- Сердечко для альбома -->
                                            <ToggleButton Style="{StaticResource HeartButtonStyle}"
                                                  Width="30" Height="30"
                                                  HorizontalAlignment="Right"
                                                                      Content="❤"
                                                  VerticalAlignment="Center"
                                                  Margin="0,-15,0,0"
                                                  IsChecked="{Binding IsFavorite, Mode=TwoWay}"
                                                  Click="FavoriteBtn_Click"
                                                  Background="Transparent"
                                                  BorderBrush="Transparent"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>

                            <!-- Шаблон для песни - ТОЛЬКО ПЕСНИ растягиваются на всю ширину -->
                            <DataTemplate x:Key="SongTemplate">
                                <Border CornerRadius="10" 
                    Background="#1A1A1A" 
                    Margin="0,5"
                    Cursor="Hand">
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="0" BlurRadius="15" Opacity="0.2"/>
                                    </Border.Effect>
                                    <Grid MouseDown="SongSearchItem_MouseDown">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" 
                            CornerRadius="10,0,0,10" 
                            ClipToBounds="True">
                                            <Image Source="{Binding CoverPath}" 
                               Stretch="UniformToFill"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" 
                                Margin="15,0"
                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" 
                                   FontWeight="Bold" 
                                   FontSize="16" 
                                   Foreground="White"/>
                                            <TextBlock Text="{Binding Artist}" 
                                   FontSize="14" 
                                   Foreground="#AAAAAA"/>
                                            <TextBlock Text="{Binding Album}" 
                                   FontSize="12" 
                                   Foreground="#666666"/>
                                        </StackPanel>

                                        <!-- Сердечко для песни -->
                                        <ToggleButton Grid.Column="2"
                                  Width="30" Height="30"
                                                      Content="❤"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Margin="0,0,15,0"
                                  IsChecked="{Binding IsFavorite, Mode=TwoWay}"
                                  Click="SongFavoriteBtn_Click"
                                  Style="{StaticResource HeartButtonStyle}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>

                            <selector:SearchResultsTemplateSelector x:Key="SearchTemplateSelector"
            SectionHeaderTemplate="{StaticResource SectionHeaderTemplate}"
            SeparatorTemplate="{StaticResource SeparatorTemplate}"
            NoResultsTemplate="{StaticResource NoResultsTemplate}"
            GenreTemplate="{StaticResource GenreTemplate}"
            ArtistTemplate="{StaticResource ArtistTemplate}"
            AlbumTemplate="{StaticResource AlbumTemplate}"
            SongTemplate="{StaticResource SongTemplate}"/>
                        </ListView.Resources>

                        <!-- ТЕПЕРЬ ВАЖНО: используем разные панели в зависимости от типа -->
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ContentControl Content="{Binding}"
                            ContentTemplateSelector="{StaticResource SearchTemplateSelector}"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- SongsList -->
                    <ListView x:Name="SongsList" 
          Visibility="Collapsed"
          SelectionMode="Single"
          Background="Transparent"
          BorderThickness="0"
                              Margin="0,70,0,0"
          SelectionChanged="SongsList_SelectionChanged">

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" 
                    Background="#1A1A1A" 
                    Margin="0,5">
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="0" BlurRadius="15" Opacity="0.2"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" 
                            CornerRadius="10,0,0,10" 
                            ClipToBounds="True">
                                            <Image Source="{Binding CoverPath}" 
                               Stretch="UniformToFill"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" 
                                Margin="15,0"
                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" 
                                   FontWeight="Bold" 
                                   FontSize="18" 
                                   Foreground="White"/>
                                            <TextBlock Text="{Binding Artist}" 
                                   FontSize="14" 
                                   Foreground="#AAAAAA"/>
                                        </StackPanel>

                                        <ToggleButton Grid.Column="2"
                                  Width="30" Height="30"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                                      Content="❤"
                                  Margin="0,0,15,0"
                                  IsChecked="{Binding IsFavorite, Mode=TwoWay}"
                                  Click="SongFavoriteBtn_Click"
                                  Style="{StaticResource HeartButtonStyle}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <!-- ArtistPanel -->
                    <Grid x:Name="ArtistPanel" Visibility="Hidden">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Шапка артиста -->
                        <Border Grid.Row="0" 
                                Background="#1A1A1A" 
                                CornerRadius="15"
                                Margin="0,0,0,25"
                                Padding="25">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="140" Height="140"
                                        Margin="0,0,25,0"
                                        CornerRadius="10"
                                        ClipToBounds="True">
                                    <Image x:Name="ArtistPhoto" 
                                           Stretch="UniformToFill"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="ArtistName" 
                                               Text="Artist Name" 
                                               FontSize="32" 
                                               FontWeight="Bold"
                                               Foreground="White"/>
                                    <TextBlock x:Name="ArtistSubscribers" 
                                               Text="subscribers" 
                                               FontSize="16" 
                                               Foreground="#FFDA0000"
                                               FontWeight="SemiBold"
                                               Margin="0,5,0,10"/>
                                    <TextBlock x:Name="ArtistBio" 
                                               Text="Biography" 
                                               FontSize="14" 
                                               Foreground="#AAAAAA" 
                                               TextWrapping="Wrap"
                                               MaxWidth="500"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" 
                                            VerticalAlignment="Center"
                                            Margin="25,0,0,0">
                                    <ToggleButton x:Name="ArtistFavoriteBtn"
                                                  Content="❤ Follow"
                                                  Style="{StaticResource MaterialDesignOutlinedButton}"
                                                  Width="160" Height="40"
                                                  Foreground="#FFDA0000"
                                                  BorderBrush="#FFDA0000"
                                                  Click="ArtistFavoriteBtn_Click"/>
                                    <Button Content="← Back"
                                            Click="BackFromSearch_Click"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Foreground="#AAAAAA"
                                            Margin="0,10,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Альбомы артиста -->
                        <ScrollViewer Grid.Row="1" 
                                      VerticalScrollBarVisibility="Auto" 
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ArtistAlbumsGrid">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12" 
                                                Background="#1A1A1A" 
                                                Margin="12"
                                                Width="200"
                                                Height="260"
                                                Cursor="Hand">
                                            <Border.Effect>
                                                <DropShadowEffect ShadowDepth="0" BlurRadius="20" Opacity="0.3"/>
                                            </Border.Effect>
                                            <StackPanel MouseDown="Album_Click">
                                                <Border CornerRadius="12,12,0,0" 
                                                        Height="160" 
                                                        ClipToBounds="True">
                                                    <Image Source="{Binding CoverPath}" 
                                                           Stretch="UniformToFill"/>
                                                </Border>
                                                <StackPanel Margin="15,15">
                                                    <TextBlock Text="{Binding Title}" 
                                                               FontWeight="Bold" 
                                                               FontSize="16" 
                                                               Foreground="White"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <ToggleButton Style="{StaticResource HeartButtonStyle}"
                                                                  Width="30" Height="30"
                                                                  HorizontalAlignment="Right"
                                                                  VerticalAlignment="Center"
                                                                  Content="❤"
                                                                  Margin="0,-25,0,0"
                                                                  IsChecked="{Binding IsFavorite, Mode=TwoWay}"
                                                                  Click="FavoriteBtn_Click"
                                                                  Background="Transparent"
                                                                  BorderBrush="Transparent"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- Правая панель (плеер) -->
        <Border Grid.Column="2" 
                Background="#121212" 
                BorderBrush="#1A1A1A" 
                BorderThickness="1,0,0,0">
            <Grid Margin="30,30,30,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto" MinHeight="243.837"/>
                </Grid.RowDefinitions>

                <!-- Сейчас играет -->
                <StackPanel Grid.Row="0" Margin="0,0,0,40">
                    <TextBlock Text="NOW PLAYING"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#FFDA0000"
                               Margin="0,0,0,5"/>
                    <TextBlock x:Name="CurrentSongTitle" 
                               Text="Song Title" 
                               FontSize="28" 
                               FontWeight="Bold"
                               Foreground="White"
                               TextTrimming="CharacterEllipsis"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="CurrentArtistButton" 
                                Click="CurrentArtistButton_Click"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="#AAAAAA">
                            <TextBlock x:Name="CurrentArtistText" 
                                       Text="Artist" 
                                       FontSize="16"/>
                        </Button>
                        <TextBlock Text="•" 
                                   Foreground="#666666" 
                                   Margin="10,0"/>
                        <Button x:Name="CurrentAlbumButton" 
                                Click="CurrentAlbumButton_Click"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="#AAAAAA">
                            <TextBlock x:Name="CurrentAlbumText" 
                                       Text="Album" 
                                       FontSize="16"/>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Обложка -->
                <Border 
                        CornerRadius="20" 
                        ClipToBounds="True"
                        Margin="0,140,0,10" Grid.RowSpan="2">
                    <Image x:Name="CurrentSongCover" 
                           Stretch="UniformToFill" Margin="0,0,0,-6"/>
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="50">
                            <DropShadowEffect.Color>
                                <Color A="76" R="255" G="218" B="0"/>
                            </DropShadowEffect.Color>
                        </DropShadowEffect>
                    </Border.Effect>
                </Border>

                <!-- Управление плеером -->
                <StackPanel Grid.Row="2" Margin="0,30,0,0">
                    <!-- Прогресс-бар -->
                    <Grid Margin="0,0,0,25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="CurrentTimeText" 
                                   Text="0:00" 
                                   FontSize="12" 
                                   Foreground="#AAAAAA"
                                   VerticalAlignment="Center"/>

                        <Border Grid.Column="1" 
                                Height="6" 
                                CornerRadius="3"
                                Background="#333333"
                                Margin="10,0,10,0"
                                VerticalAlignment="Center">
                            <ProgressBar x:Name="PlayerProgress" 
                                         Style="{StaticResource MaterialDesignLinearProgressBar}"
                                         Background="Transparent"
                                         Foreground="#FFDA0000"
                                         PreviewMouseDown="PlayerProgress_PreviewMouseDown"
                                         PreviewMouseUp="PlayerProgress_PreviewMouseUp"/>
                        </Border>

                        <TextBlock x:Name="TotalTimeText" 
                                   Grid.Column="2"
                                   Text="0:00" 
                                   FontSize="12" 
                                   Foreground="#AAAAAA"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Кнопки управления -->
                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Center"
                                Margin="0,0,0,30">
                        <Button Content="⏮"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Foreground="#AAAAAA"
                                Width="50" Height="50"
                                Margin="0,0,20,0"/>

                        <Button Content="⏯" 
                                Click="PlayPauseBtn_Click"
                                Style="{StaticResource MaterialDesignFloatingActionButton}"
                                Background="#FFDA0000" 
                                Foreground="White"
                                Width="70" Height="70"
                                FontSize="24"
                                Margin="0,0,20,0"/>

                        <Button Content="⏭"
                                Click="NextBtn_Click"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Foreground="#AAAAAA"
                                Width="50" Height="50"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MediaElement для воспроизведения музыки -->
        <MediaElement x:Name="Player" 
              LoadedBehavior="Manual" 
              UnloadedBehavior="Stop" 
              Visibility="Collapsed"/>

    </Grid>
</Window>